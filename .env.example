# 로컬 개발 기본값이다. 실제 운영에서는 별도 비밀값을 주입한다.
DB_PASSWORD=local-support-password
DB_ROOT_PASSWORD=local-root-password
LOCAL_ACCOUNT_PASSWORD=Portfolio2026!
PORT=8087
LOCAL_SEED=true

# 실제 OCR 내부 API: 32자 이상의 무작위 토큰을 앱과 OCR API에 동일하게 주입한다.
OCR_LIVE_ENABLED=false
OCR_API_URL=http://127.0.0.1:8091
OCR_API_TOKEN=
OCR_AI_ENABLED=false
# nvidia(테스트) / openrouter(운영) / disabled. 키는 OCR API 프로세스에만 필요하다.
AI_PROVIDER=disabled
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=
# 일반 계정은 사용자별, 내부 회귀 시나리오는 공간별 일일 AI 요청 한도
AI_LIMIT_PER_DAY=2
AI_LIMIT_GLOBAL_PER_DAY=20
AI_TIMEOUT_SECONDS=60

# 공개 배포 전 확정할 운영자 공개 정보 (키·비밀번호를 넣지 않는다).
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_HOSTING_PROVIDER=

# 공개 계정 자료 정리: 매일 한국시간 04시 기준, 진행 중 작업은 완료 후 재시도.
PUBLIC_DEMO_LOGIN=applicant
# 파일 전체 상한 512MiB, 디스크 여유 1GiB 확보. 기존 동일 파일 재사용은 허용.
FILE_MAX_BYTES=536870912
FILE_MIN_FREE_BYTES=1073741824
# OCR 모델·전처리·분류 규칙을 변경하면 값을 올려 이전 결과 캐시를 무효화한다.
DOCUMENT_PIPELINE_VERSION=pdfbox-3.0.8-paddle-v5-ko-layout-v2

# 다른 포트폴리오와 같은 경로를 사용하면 로컬 공급자 호출 예산을 공유한다.
# NVIDIA 계정 전체 40 RPM 중 이 서비스 기본 예산은 6 RPM, 동시 호출은 1건이다.
AI_REQUESTS_PER_MINUTE=6
AI_RATE_STATE_PATH=

# PDFBox 모듈 기본 경로를 바꾸는 환경에서만 지정한다.
PDF_ENGINE_JAR=
PDF_JAVA=
