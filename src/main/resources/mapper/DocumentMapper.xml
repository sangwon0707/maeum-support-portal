<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC '-//mybatis.org//DTD Mapper 3.0//EN'
  'https://mybatis.org/dtd/mybatis-3-mapper.dtd'>
<mapper namespace="kr.co.maeum.support.document.DocumentMapper">
  <select id="find" resultType="kr.co.maeum.support.document.Document">
    SELECT *
    FROM document
    WHERE id=#{id}
  </select>
  <select id="current" resultType="kr.co.maeum.support.document.Document">
    SELECT d.*
    FROM document d
    WHERE application_id=#{applicationId}
    AND NOT EXISTS(SELECT 1
    FROM document n
    WHERE n.application_id=d.application_id
    AND n.type_code=d.type_code
    AND n.version&gt;d.version)
    ORDER BY type_code
  </select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO document(application_id,type_code,version,storage_key,original_name,mime_type,size_bytes,sha256,created_by)
    VALUES(#{applicationId},#{typeCode},#{version},#{storageKey},#{originalName},#{mimeType},#{sizeBytes},#{sha256},#{createdBy})
  </insert>
</mapper>
