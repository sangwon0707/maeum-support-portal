<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="t" tagdir="/WEB-INF/tags" %>
<t:layout title="신청 문서 검토">
  <link rel="stylesheet" href="${base}/assets/intake.css?v=13">
  <script src="${base}/assets/intake.js?v=14" defer></script>
  <div data-intake-mode="${intake.execution_mode}" class="intake-workspace ${not empty analysis.pages?'is-review':''}"><div class="page-heading"><p class="eyebrow"><c:out value="${application.programTitle}" /></p><h1>작성한 문서로 신청하세요.</h1><p>신청 내용과 사진을 읽어 정리하고, 원본과 대조한 뒤 제출할 수 있습니다.</p></div>
  <ol class="steps"><li class="${empty analysis.pages?'active':''}">1 문서 접수·분류</li><li class="${not empty analysis.pages && intake.status!='APPLIED'?'active':''}">2 내용·사진 검토</li><li class="${intake.status=='APPLIED'?'active':''}">3 확인·반영</li><li>4 최종 제출</li></ol>
  <div class="intake-controls"><c:if test="${canUpload}"><div class="intake-file-actions"><button type="button" class="krds-btn medium secondary" data-program-upload-open>${empty intake?'문서 업로드':'파일 바꾸기'}</button></div><t:intake-picker options="${sampleOptions}" action="${base}/applications/${application.id}/intake" /></c:if>
  <c:if test="${not empty intake && intake.status!='UPLOADED'}">
    <section class="intake-progress ${not empty analysis.pages?'is-ready':''}" data-intake-progress data-stage="${intake.stage}" aria-busy="${intake.status=='QUEUED' || intake.status=='PROCESSING'}" data-status="${intake.status}" data-url="${base}/applications/${application.id}/intake/status?intakeId=${intake.id}">
      <c:if test="${intake.execution_mode=='PREPARED'}"><p class="intake-mode-disclosure"><strong>OCR 검토 데모</strong> · 실제 OCR을 실행하지 않고, 미리 인식한 결과를 이용해 문서 검토 과정을 보여줍니다.</p></c:if>
      <c:if test="${intake.execution_mode=='LIVE'}"><p class="intake-mode-disclosure"><strong>OCR 실제 검토</strong> · 업로드한 문서를 서버에서 직접 인식합니다. 서버 사양에 따라 10분 이상 걸릴 수 있습니다.</p></c:if>
      <div class="intake-progress-top"><div><p class="eyebrow">문서 처리</p><h2 class="intake-processing-title"><span class="intake-loading-circle" aria-hidden="true"></span><span data-intake-stage>${intake.status=='READY' || intake.status=='APPLIED'?'검토할 자료를 정리했습니다.':intake.status=='FAILED'?'문서를 처리하지 못했습니다.':intake.execution_mode=='PREPARED'?'검토 자료를 불러오고 있습니다.':'문서를 읽고 있습니다.'}</span></h2><p data-intake-detail><c:out value="${intake.detail}" /></p></div><strong data-intake-percent>${intake.progress}%</strong></div>
      <div class="intake-progress-track" role="progressbar" aria-label="문서 처리 진행률" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${intake.progress}"><span style="width:${intake.progress}%"></span></div>
      <ol class="intake-stages"><li>파일 접수</li><li>페이지·문서 분리</li><li>내용·사진 추출</li><li>검토표 구성</li></ol>
      <c:if test="${intake.status=='FAILED'}"><p class="alert error"><c:choose><c:when test="${intake.error_code=='STORAGE_CAPACITY_REACHED'}">서류 저장 공간이 부족해 처리를 완료하지 못했습니다. 자료 정리 후 다시 이용해 주세요.</c:when><c:otherwise>분석을 완료하지 못했습니다. 파일 손상·페이지 수·암호 여부를 확인한 뒤 다시 업로드해 주세요.</c:otherwise></c:choose> 오류: <c:out value="${intake.error_code}" /></p></c:if>
    </section>
    <details class="intake-source-files"><summary>접수한 원본 ${sources.size()}개</summary><c:forEach var="source" items="${sources}"><p><a href="${base}/intakes/${intake.id}/assets/${source.storage_key}" target="_blank" rel="noopener"><c:out value="${source.original_name}" /> ↗</a> <small>약 ${source.size_bytes / 1024} KiB</small></p></c:forEach></details>
  </c:if>
  </div>
  <c:if test="${intake.status=='UPLOADED'}">
    <section class="intake-awaiting-analysis">
      <div class="intake-awaiting-header"><div><p class="eyebrow">업로드 완료 · 검토 요청 전</p><h2>올린 문서를 확인해 주세요.</h2><p>올린 서류를 확인한 뒤 ‘문서 검토 요청’을 눌러 주세요.</p></div>
      <c:if test="${canStartAnalysis}"><form id="intake-review-request" method="post" action="${base}/applications/${application.id}/intake/${intake.id}/start"><t:csrf /><button class="krds-btn medium primary" data-tour="올린 서류를 확인하고 문서 검토를 요청해 주세요." ${activeAnalysis.active?'disabled':''}>문서 검토 요청</button></form></c:if></div>
      <c:if test="${canStartAnalysis}"><fieldset class="intake-review-modes"><legend>검토 방식</legend><label class="review-mode-option"><input form="intake-review-request" type="radio" name="mode" value="PREPARED" data-review-mode ${preparedAvailable?'checked':'disabled'}><span><strong>OCR 검토 데모</strong><small>${preparedAvailable?'실제 OCR을 실행하지 않고, 미리 인식한 결과를 이용해 문서 검토 과정을 보여줍니다.':'이 파일은 OCR 검토 데모를 지원하지 않습니다'}</small></span></label><label class="review-mode-option"><input form="intake-review-request" type="radio" name="mode" value="LIVE" data-review-mode ${preparedAvailable?'':'checked'}><span><strong>OCR 실제 검토</strong><small>업로드한 문서를 서버에서 직접 인식합니다. 서버 사양에 따라 10분 이상 걸릴 수 있습니다.</small></span></label></fieldset>
      <p class="intake-mode-disclosure" data-prepared-review-help>실제 OCR을 실행하지 않고, 미리 인식한 결과를 이용해 문서 검토 과정을 보여줍니다. 진행 표시는 약 12초 동안 단계별로 보여줍니다.</p>
      <label class="checkbox-label intake-slow-warning" data-live-review-warning hidden><input form="intake-review-request" type="checkbox" name="slowAcknowledged" value="true" data-slow-acknowledgment><span>서버의 컴퓨팅 자원이 적어 실제 OCR에 10분 이상 걸릴 수 있음을 확인했습니다. 처리 중에도 다른 화면을 이용할 수 있습니다. 실제 검토에서는 추출한 문구가 항목 해석을 위해 OpenRouter와 선택 모델 공급자에 전송됩니다. 개인정보·민감정보가 없는 가상 문서만 사용하겠습니다.</span></label></c:if>
      <c:if test="${activeAnalysis.active}"><p class="alert">다른 문서의 분석이 진행 중입니다. <a href="${base}${activeAnalysis.resumeUrl}">진행 중인 분석 확인 →</a></p></c:if>
      <c:forEach var="source" items="${sources}"><div class="intake-source-heading"><strong><c:out value="${source.original_name}" /></strong><a href="${base}/intakes/${intake.id}/assets/${source.storage_key}" target="_blank" rel="noopener">원본 열기 ↗</a></div><c:choose><c:when test="${source.mime_type=='application/pdf'}"><iframe class="intake-uploaded-pdf" title="업로드한 원본 문서" src="${base}/intakes/${intake.id}/assets/${source.storage_key}#view=Fit&amp;toolbar=1&amp;navpanes=0"></iframe></c:when><c:otherwise><img class="intake-uploaded-image" src="${base}/intakes/${intake.id}/assets/${source.storage_key}" alt="업로드한 원본 문서"></c:otherwise></c:choose></c:forEach>
      <p><a href="${base}/programs/${application.programId}">← 공고로 돌아가기</a></p>
    </section>
  </c:if>
  <c:if test="${not empty analysis.pages}">
    <c:if test="${intake.execution_mode=='PREPARED' && canApply}"><details class="intake-live-test"><summary>이 문서로 OCR 실제 검토하기</summary><p>준비된 결과 대신 서버에서 새로 인식합니다. 작은 무료 서버를 사용하므로 처리에 10분 이상 걸릴 수 있습니다. 기존 검토 결과는 보존됩니다.</p><form method="post" action="${base}/applications/${application.id}/intake/${intake.id}/live-test"><t:csrf /><input type="hidden" name="requestKey" value="${liveTestKey}"><label class="checkbox-label"><input type="checkbox" name="slowAcknowledged" value="true" required><span>처리 시간과 외부 AI 전송 안내를 확인했습니다. 추출 문구가 OpenRouter와 선택 모델 공급자에 전송되므로 개인정보·민감정보가 없는 가상 문서만 사용하겠습니다.</span></label><button class="krds-btn medium secondary">OCR 실제 검토 요청</button></form></details></c:if>
    <c:if test="${not empty analysis.aiAnalyses}">
      <details class="intake-ai-review">
        <summary>AI 문서 해석·원문 대조 결과</summary>
        <c:forEach var="ai" items="${analysis.aiAnalyses}">
          <div class="intake-ai-layout">
            <div>
              <strong><c:out value="${ai.sourceName}" /></strong>
              <p><c:choose><c:when test="${ai.status=='SUCCEEDED'}">원문 대조 ${ai.verifiedCount}건 · 제외 ${ai.rejectedCount}건<br>값 차이 ${ai.conflicts.size()}건<c:if test="${not empty ai.supplementedCount}"> · 누락 보완 ${ai.supplementedCount}건</c:if></c:when><c:when test="${ai.status=='TIMEOUT'}">AI 응답 대기시간을 초과했습니다.</c:when><c:when test="${ai.status=='RATE_LIMITED' || ai.status=='LOCAL_RATE_LIMITED'}">AI 요청이 많습니다. 잠시 후 다시 요청할 수 있습니다.</c:when><c:otherwise>AI 해석을 완료하지 못해 기본 인식 결과를 표시합니다.</c:otherwise></c:choose></p>
              <small><c:out value="${ai.provider}" /> · <c:out value="${ai.model}" /></small>
              <p class="intake-ai-explanation"><c:if test="${intake.execution_mode=='PREPARED'}">미리 실행해 저장한 AI 해석 결과입니다. </c:if>원문에서 확인한 누락값만 보완합니다. 기존 값과 다른 후보와 문서 분류 제안은 직접 확인해 주세요.</p>
            </div>
            <c:if test="${ai.status=='SUCCEEDED'}">
              <div class="intake-ai-pages"><table><caption>페이지별 AI 문서 분류 제안과 원문 근거</caption><thead><tr><th>쪽</th><th>분류 제안</th><th>원문 근거</th><th>기본 분류 대조</th></tr></thead><tbody>
                <c:forEach var="pageResult" items="${ai.pageResults}"><tr><td>${pageResult.pageNumber}</td><td><c:out value="${pageResult.kindLabel}" /></td><td><c:out value="${pageResult.kindEvidence.text}" /></td><td>${pageResult.kindAgreement?'일치':'확인 필요'}</td></tr></c:forEach>
              </tbody></table></div>
            </c:if>
          </div>
        </c:forEach>
      </details>
    </c:if>
    <div class="intake-result-strip"><span><strong>${analysis.pageCount}</strong>쪽</span><span><strong>${analysis.groups.size()}</strong>개 문서</span><span>사진 <strong>${analysis.photoCount}</strong>개</span><span>추출 항목 <strong>${analysis.fields.size()}</strong>개</span><c:if test="${not empty analysis.conflicts}"><span class="intake-warning">서로 다른 값 ${analysis.conflicts.size()}개 · 원본 대조 필요</span></c:if><c:if test="${intake.status=='APPLIED'}"><span>신청서 반영 완료</span></c:if></div>
    <form method="post" action="${base}/applications/${application.id}/intake/${intake.id}/${canRevise?'save':'apply'}" data-intake-review>
      <t:csrf /><input type="hidden" name="version" value="${application.version}">
      <div class="intake-desk">
        <section class="intake-viewer" aria-label="원본 문서 뷰어">
          <div class="intake-pane-heading"><h2>원본 문서</h2><small class="intake-source-badge" data-intake-text-source>${intake.execution_mode=='PREPARED'?'OCR 검토 데모':analysis.pages[0].textSource=='PDF_TEXT'?'PDF 원문':'실제 OCR'}</small><button type="button" class="intake-zoom" data-intake-zoom aria-pressed="false">확대</button><span data-intake-preview-label>${analysis.pages[0].pageNumber} / ${analysis.pageCount}쪽</span></div>
          <div class="intake-viewer-body">
            <div class="intake-thumbnails" aria-label="원본 페이지 선택"><c:forEach var="page" items="${analysis.pages}" varStatus="pageLoop"><button type="button" data-intake-page aria-pressed="${page==analysis.pages[0]}" data-source-id="${page.sourceId}" data-page-number="${page.pageNumber}" data-text-source="${page.textSource}" data-preview="${base}/intakes/${intake.id}/assets/${page.previewKey}" data-source-name="<c:out value='${page.sourceName}'/>"><img src="${base}/intakes/${intake.id}/assets/${page.previewKey}" alt="${page.pageNumber}쪽"><span>${pageLoop.count} · <c:out value="${page.kindLabel}" /></span></button></c:forEach></div>
            <div class="intake-preview-frame"><img data-intake-preview src="${base}/intakes/${intake.id}/assets/${analysis.pages[0].previewKey}" alt="선택한 원본 페이지"></div>
          </div>
        </section>
        <section class="intake-inspector" aria-label="추출 자료 검토">
          <div class="intake-tabs" role="tablist" aria-label="검토 항목"><button type="button" role="tab" id="tab-content" aria-controls="panel-content" aria-selected="true" data-intake-tab="content">신청 내용</button><button type="button" role="tab" id="tab-documents" aria-controls="panel-documents" aria-selected="false" tabindex="-1" data-intake-tab="documents">서류 분할 <span>${analysis.groups.size()}</span></button><button type="button" role="tab" id="tab-media" aria-controls="panel-media" aria-selected="false" tabindex="-1" data-intake-tab="media">사진·표 <span>${analysis.photoCount}</span></button></div>
          <div class="intake-inspector-scroll">
            <div role="tabpanel" id="panel-content" aria-labelledby="tab-content" data-intake-panel="content"><div class="intake-section-heading"><h2>신청 내용</h2><span data-intake-edit-hint>${canApply?'값을 눌러 수정 · ↗ 원본 대조':canRevise?'신청 내용 수정 버튼으로 편집':'제출 완료 · 내용 수정 제한'}</span></div>
          <h3 class="intake-section-label">사업자 정보</h3>
          <div class="intake-compact-fields"><c:forEach var="field" items="${formFields}"><c:if test="${field.name!='requestedAmount' && field.name!='selfContribution'}"><div class="intake-field-row ${field.name=='address'?'is-wide':''}"><label for="intake-${field.name}"><c:out value="${field.name=='businessNo'?'사업자번호':field.label}" /></label><input id="intake-${field.name}" name="${field.name}" type="${field.type}" value="<c:out value='${form[field.name]}'/>" ${field.name=='businessNo'?'inputmode="numeric" maxlength="10" pattern="[0-9]{10}" title="숫자 10자리"':''} ${canApply?'required':'readonly'}><c:if test="${not empty analysis.evidence[field.name]}"><button type="button" class="intake-source-link" data-evidence-source="${analysis.evidence[field.name].sourceId}" data-evidence-page="${analysis.evidence[field.name].pageNumber}" aria-label="<c:out value='${field.label}'/> 원본 ${analysis.evidence[field.name].pageNumber}쪽 확인" title="<c:out value='${analysis.evidence[field.name].sourceName}'/> ${analysis.evidence[field.name].pageNumber}쪽">↗</button></c:if></div></c:if></c:forEach></div>
          <h3 class="intake-section-label">사업비 <span>원</span></h3>
          <div class="intake-compact-fields intake-amount-fields"><c:forEach var="field" items="${formFields}"><c:if test="${field.name=='requestedAmount' || field.name=='selfContribution'}"><div class="intake-field-row"><label for="intake-${field.name}">${field.name=='requestedAmount'?'신청금액':'자부담'}</label><input id="intake-${field.name}" name="${field.name}" type="number" min="0" value="<c:out value='${form[field.name]}'/>" ${canApply?'required':'readonly'}><c:if test="${not empty analysis.evidence[field.name]}"><button type="button" class="intake-source-link" data-evidence-source="${analysis.evidence[field.name].sourceId}" data-evidence-page="${analysis.evidence[field.name].pageNumber}" aria-label="${field.name=='requestedAmount'?'신청금액':'자부담'} 원본 ${analysis.evidence[field.name].pageNumber}쪽 확인" title="원본 ${analysis.evidence[field.name].pageNumber}쪽">↗</button></c:if></div></c:if></c:forEach></div>
          <div class="field intake-plan-field"><label for="intake-plan">개선 계획</label><textarea id="intake-plan" name="planText" class="krds-input" rows="9" maxlength="2000" ${canApply?'required':'readonly'}><c:out value="${form.planText}" /></textarea></div>
<c:if test="${not empty analysis.conflicts}"><details class="intake-conflicts"><summary>문서 사이에 다른 값 ${analysis.conflicts.size()}개 확인</summary><c:forEach var="conflict" items="${analysis.conflicts}"><p><c:out value="${conflict.previous}" /> / <c:out value="${conflict.candidate}" /> · ${conflict.pageNumber}쪽</p></c:forEach></details></c:if></div>
            <div role="tabpanel" id="panel-documents" aria-labelledby="tab-documents" data-intake-panel="documents" hidden><h2>분할한 서류</h2><div class="intake-document-list"><c:forEach var="group" items="${analysis.groups}"><a href="${base}/intakes/${intake.id}/assets/${group.pdfKey}" target="_blank" rel="noopener"><strong><c:out value="${group.kindLabel}" /></strong><span><c:out value="${group.sourceName}" /> · ${group.pageNumbers}쪽</span><b>분할 PDF 열기 ↗</b></a></c:forEach></div><p class="field-help">여러 쪽짜리 서류는 한 문서로 묶습니다. 종류나 경계가 다르면 아래 페이지에서 바로잡을 수 있습니다.</p><div class="intake-page-list"><c:forEach var="page" items="${analysis.pages}" varStatus="loop"><div class="intake-page-row"><button type="button" data-intake-page data-source-id="${page.sourceId}" data-page-number="${page.pageNumber}" data-text-source="${page.textSource}" data-preview="${base}/intakes/${intake.id}/assets/${page.previewKey}" data-source-name="<c:out value='${page.sourceName}'/>"><img src="${base}/intakes/${intake.id}/assets/${page.previewKey}" alt="${page.pageNumber}쪽"><span>${page.pageNumber}쪽</span></button><div><label>문서 종류<select class="krds-input" name="pageKinds" ${canApply?'':'disabled'}><c:forEach var="kind" items="${kinds}"><option value="${kind.code}" ${kind.code==page.kind?'selected':''}><c:out value="${kind.label}" /></option></c:forEach></select></label><label class="intake-boundary"><input type="checkbox" name="groupStarts" value="${loop.index}" ${page.groupStart?'checked':''} ${canApply?'':'disabled'}> 새 문서 시작</label></div></div></c:forEach></div></div>
            <div role="tabpanel" id="panel-media" aria-labelledby="tab-media" data-intake-panel="media" hidden><h2>문서에서 추출한 사진</h2><p class="field-help">사진의 출처와 잘린 범위를 확인하고 신청에 포함할 이미지를 선택해 주세요.</p><div class="intake-photo-grid"><c:forEach var="page" items="${analysis.pages}"><c:forEach var="photo" items="${page.photos}"><figure><a href="${base}/intakes/${intake.id}/assets/${photo.storageKey}" target="_blank" rel="noopener"><img src="${base}/intakes/${intake.id}/assets/${photo.storageKey}" alt="원본 ${page.pageNumber}쪽에서 추출한 이미지"></a><figcaption><label><input type="checkbox" name="photoKeys" value="${photo.storageKey}" ${intake.status!='APPLIED' || photo.selected?'checked':''} ${canApply?'':'disabled'}> 신청에 포함</label><span>${page.pageNumber}쪽 · ${photo.method=='PDF_IMAGE_REGION'?'문서 포함 이미지':'사진 영역 후보'}</span></figcaption></figure></c:forEach></c:forEach></div><c:if test="${analysis.photoCount==0}"><p>분리된 사진이 없습니다. 원본 페이지를 확인해 주세요.</p></c:if><details><summary>표·산출 내역 확인</summary><c:forEach var="page" items="${analysis.pages}"><c:if test="${not empty page.tableRows}"><h3>${page.pageNumber}쪽 · <c:out value="${page.kindLabel}" /></h3><div class="intake-table-scroll"><table class="intake-extracted-table"><tbody><c:forEach var="row" items="${page.tableRows}"><tr><c:forEach var="cell" items="${row.cells}"><td><c:out value="${cell.text}" /></td></c:forEach></tr></c:forEach></tbody></table></div></c:if></c:forEach></details><details><summary>페이지별 추출 원문 확인</summary><c:forEach var="page" items="${analysis.pages}"><h3>${page.pageNumber}쪽 · <c:out value="${page.kindLabel}" /></h3><div class="intake-text-lines"><c:forEach var="line" items="${page.lines}"><span><c:out value="${line.text}" /></span></c:forEach></div></c:forEach></details></div>
          </div>
        </section>
      </div>
      <div class="intake-action-bar"><a class="intake-back-link" href="${base}${intake.status=='APPLIED'?'/applications/':'/programs/'}${intake.status=='APPLIED'?application.id:application.programId}${intake.status=='APPLIED'?'/confirm':''}">← ${intake.status=='APPLIED'?'제출 전 확인으로':'공고로 돌아가기'}</a><div class="actions"><c:if test="${canRevise}"><button type="button" class="krds-btn medium secondary" data-intake-edit>신청 내용 수정</button><button type="button" class="krds-btn medium secondary" data-intake-edit-cancel hidden>수정 취소</button><button class="krds-btn medium primary" data-intake-save hidden>수정 내용 저장</button></c:if><c:if test="${canApply}"><button class="krds-btn medium primary" data-tour="분류·신청 내용·사진을 검토한 뒤 신청서에 반영하세요.">검토 내용 반영</button></c:if><a href="${base}/applications/${application.id}/confirm" class="krds-btn medium secondary">최종 제출 확인 →</a></div></div>
    </form>
  </c:if>
</div>
</t:layout>
